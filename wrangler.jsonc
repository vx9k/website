// Cloudflare Workers config. The site is a static export served from
// out/ as static assets alone: there is no Worker script, so every
// request is answered from Cloudflare's cache without running code, and
// static asset requests are free and unmetered on every plan.
// public/_headers sets the response headers, public/_redirects the
// redirects.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "website",
  "compatibility_date": "2026-10-08",
  // kthread.dev is attached as a Custom Domain (Cloudflare manages its DNS
  // record and certificate). www.kthread.dev 301s here via a zone
  // Redirect Rule.
  "routes": [{ "pattern": "kthread.dev", "custom_domain": true }],
  "assets": {
    "directory": "./out",
    // Unknown paths get out/404.html with a real 404 status.
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // Every non-production branch gets its own Preview URL (posted on its
  // PR). Empty because previews use the same settings as production.
  "preview_urls": true,
  "previews": {}
}
